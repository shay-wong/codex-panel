{
  "name": "codex-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "panelctl": "./cli/panelctl.mjs"
  },
  "scripts": {
    "codex": "node scripts/codex-injector.mjs --launch --watch --open",
    "codex:inject": "node scripts/codex-injector.mjs --watch",
    "codex:daemon": "node scripts/codex-injector.mjs --daemon --open",
    "codex:refresh": "node scripts/codex-injector.mjs --refresh",
    "codex:install": "node scripts/install-macos-launcher.mjs",
    "launcher:install": "node scripts/install-macos-launcher.mjs",
    "app:prepare": "npm run build:web && node scripts/prepare-tauri-app.mjs",
    "app:dev": "npm run app:prepare && tauri dev",
    "app:build": "npm run app:prepare -- --target universal-apple-darwin && CI=true tauri build --target universal-apple-darwin --bundles app,dmg --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
    "app:build:local": "npm run app:prepare -- --target aarch64-apple-darwin && CI=true tauri build --target aarch64-apple-darwin --bundles app --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
    "app:build:windows": "node scripts/build-windows-app.mjs",
    "app:preflight": "node scripts/preflight-macos-app.mjs",
    "app:verify-packaged-panelctl": "node scripts/verify-packaged-taskctl.mjs",
    "tauri": "tauri",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/index.mjs --dev",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:cloud": "npm run build:web && wrangler dev --local",
    "build": "vite build --config web/vite.config.ts && node scripts/codex-injector.mjs --refresh-if-running",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "start": "node server/index.mjs",
    "panelctl": "node cli/panelctl.mjs",
    "test": "node --test && npm run test:components",
    "test:components": "vitest run web/src/components/MarkdownDocument.test.tsx web/src/api.test.ts --environment jsdom",
    "test:cloud": "node --test test/cloud-shared-worker.test.mjs",
    "cloud:migrate:local": "wrangler d1 migrations apply codex-panel-db --local",
    "cloud:migrate": "wrangler d1 migrations apply codex-panel-db --remote",
    "cloud:deploy:dry-run": "npm run build:web && wrangler deploy --dry-run",
    "cloud:deploy": "npm run build:web && wrangler deploy",
    "cloud:data": "node scripts/migrate-to-cloud.mjs",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.94.0",
    "@xyflow/react": "^12.11.2",
    "dhtmlx-gantt": "^10.0.0",
    "dompurify": "^3.4.13",
    "js-yaml": "4.1.1",
    "mdast-util-definitions": "^6.0.0",
    "mermaid": "^11.16.1",
    "micromark-util-decode-string": "^2.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "smol-toml": "^1.8.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^27.4.0",
    "miniflare": "^4.20260722.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
