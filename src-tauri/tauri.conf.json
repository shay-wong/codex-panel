{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Panel",
  "version": "0.1.0",
  "identifier": "com.shay.codex-panel",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Codex Panel",
        "width": 760,
        "height": 560,
        "minWidth": 620,
        "minHeight": 480,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "在 Codex 客户端中打开本地任务面板",
    "createUpdaterArtifacts": false,
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/": ""
    },
    "icon": ["../web/public/codex-app-icon.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
